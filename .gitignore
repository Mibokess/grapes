# Go binary
/grapes

# Go build/test artifacts
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# Go workspace
go.work
go.work.sum

# OS
.DS_Store
Thumbs.db

# Local
old/

# GoReleaser
dist/

# Grapes temp files
.grapes/*/tmp/
.grapes/tmp/

# Grapes ID-allocation lock (kept on disk between runs; see data.NextID)
.grapes/.lock
.grapes/*/.lock
.grapes/config.toml.lock

# Grapes atomic-write temp files (only present if a write was interrupted)
.grapes/.*.tmp-*
.grapes/*/.*.tmp-*

# Env
.env
.env.*
!.env.example
!.env.test
